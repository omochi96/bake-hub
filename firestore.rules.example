rules_version = '2';

// BAKE HUB のセキュリティルール(SPEC.md 11章)
// 使い方: このファイルを firestore.rules にコピーし、OWNER_EMAIL@example.com を店主のGoogleアカウントのメールに直す。
// 読み書きできるのは、店主のGoogleアカウントで、自分の場所(users/<自分のid>)だけ。
// それ以外の人は、URLを知っていても、ログインしても、何も見られない。
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == "OWNER_EMAIL@example.com"
        && request.auth.token.email_verified == true;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }
  }
}
