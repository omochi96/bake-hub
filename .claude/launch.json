{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bake-hub",
      "runtimeExecutable": "/usr/local/bin/node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--host",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "bake-hub-running",
      "url": "http://localhost:5173",
      "port": 5173
    },
    {
      "name": "bake-hub-local-test",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "VITE_FIREBASE_API_KEY=",
        "VITE_FIREBASE_PROJECT_ID=",
        "/usr/local/bin/node",
        "node_modules/vite/bin/vite.js",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "bake-hub-dist",
      "runtimeExecutable": "/usr/local/bin/node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    }
  ]
}